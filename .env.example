# Copy this file to .env.local and fill in SUPABASE_SECRET_KEY from the
# Supabase dashboard → Project Settings → Connect dialog.
# .env.local is gitignored — never commit real keys.

# --- Client (Vite) — exposed to the browser; only VITE_-prefixed vars are. ---
