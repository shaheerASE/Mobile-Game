VITE_SUPABASE_ANON_KEY=sb_publishable_H7Zhd2LdccIZtLTPtytCNg_fz8n0_l1

# --- Server / CLI / Edge Functions (NOT exposed to the browser) ---
SUPABASE_URL=https://mygbxodwktbsrrevxcol.supabase.co
